#!/usr/bin/env bash
#
# DESCRIPTION
#   Clone all GitHub repositories for a given user or organization.
#
#   GitHub recommends you use OAuth tokens to authenticate to the GitHub API.
#   OAuth tokens include personal access tokens and enable the user to revoke
#   access at any time.
#
#   NOTE: If resources are protected by organization SAML enforcement, you must
#   grant your personal access token access to this organization.
#
#     * Personal access tokens > Configure SSO > Authorize
#
#   See also:
#     * https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/creating-a-personal-access-token
#
#   NOTE: If using SSH with an SSH key, you must grant your SSH key access to
#   this organization as well.
#
#     * SSH and GPG keys > Configure SSO > Authorize
#
#   See also:
#     * https://docs.github.com/articles/authenticating-to-a-github-organization-with-saml-single-sign-on
#
# USAGE
#   git-clone-gh [OPTIONS] [TOKEN]
#
# ARGUMENTS
#   TOKEN    GitHub personal access token (can also be set via GITHUB_API_TOKEN)
#
# OPTIONS
#   -u, --user USER             User's repositories to clone
#   -o, --org ORG               Organization's repositories to clone
#   -i, --identity-file FILE    File for the identity (private key) for public key authentication
#                               (optional, defaults to id_rsa)
#   -e, --exclude PATTERN       Add a pattern to exclude (can be used multiple times)
#   -s, --skip-archived         Whether to skip archived repositories
#   -h, --help                  Show this help message
#
# EXAMPLES
#   git-clone-gh -u nickolashkraus ghp_xxx
#   git-clone-gh -o Workiva ghp_xxx --skip-archived

# Repositories to exclude (add patterns you want to exclude).
# Each line is a pattern that will be passed to grep -v.
# Example exclusions:
#   "org/a-very-big-repo"
#   "another-big-repo"
exclude_patterns=()

# Colors
red='\033[0;31m'
green='\033[0;32m'
reset='\033[0m'

# Print usage information.
function usage() {
  echo "usage: git-clone-gh [OPTIONS] [TOKEN]"
  echo ""
  echo "Arguments:"
  echo "  TOKEN    GitHub personal access token (can also be set via GITHUB_API_TOKEN)"
  echo ""
  echo "Options:"
  echo "  -u, --user USER             User's repositories to clone"
  echo "  -o, --org ORG               Organization's repositories to clone"
  echo "  -i, --identity-file FILE    File for the identity (private key) for public key authentication"
  echo "                              (optional, defaults to id_rsa)"
  echo "  -e, --exclude PATTERN       Add a pattern to exclude (can be used multiple times)"
  echo "  -s, --skip-archived         Whether to skip archived repositories"
  echo "  -h, --help                  Show this help message"
  echo ""
}

# Exit unless the option in $1 has a value in $2.
function require_value() {
  if [[ $# -lt 2 || $2 == -* ]]; then
    echo "git-clone-gh: option '$1' requires an argument" >&2
    usage >&2
    exit 1
  fi
}

user=""
org=""
identity_file="id_rsa"
skip_archived=false
access_token=""

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -u | --user)
      require_value "$@"
      user=$2
      shift 2
      ;;
    -o | --org)
      require_value "$@"
      org=$2
      shift 2
      ;;
    -i | --identity-file)
      require_value "$@"
      identity_file=$2
      shift 2
      ;;
    -e | --exclude)
      # A pattern may start with '-', so only check that one is present.
      [[ $# -ge 2 ]] || require_value "$1"
      exclude_patterns+=("$2")
      shift 2
      ;;
    -s | --skip-archived)
      skip_archived=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "git-clone-gh: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -n "${access_token}" ]; then
        echo "git-clone-gh: extra argument '$1'" >&2
        usage >&2
        exit 1
      fi
      access_token="$1"
      shift
      ;;
  esac
done

# Error if 'user' and 'org' are either both set or not set.
if { [ -n "${user}" ] && [ -n "${org}" ]; } || { [ -z "${user}" ] && [ -z "${org}" ]; }; then
  echo "git-clone-gh: specify either a user or organization" >&2
  usage >&2
  exit 1
fi

# If no access token provided as argument, check environment variable.
if [ -z "${access_token}" ]; then
  access_token="${GITHUB_API_TOKEN}"
fi

if [ -z "${access_token}" ]; then
  echo "git-clone-gh: specify a GitHub access token" >&2
  usage >&2
  exit 1
fi

eval "$(ssh-agent -s)" >/dev/null 2>&1 &&
  ssh-add "${HOME}/.ssh/${identity_file}" >/dev/null 2>&1
# The agent holds the decrypted key, so stop it on every exit path.
trap 'ssh-agent -k >/dev/null 2>&1' EXIT

# Test SSH connection to GitHub.
ssh_output=$(ssh -T git@github.com 2>&1)
if ! echo "$ssh_output" | grep -q "successfully authenticated"; then
  echo "git-clone-gh: GitHub SSH authentication failed" >&2
  echo "$ssh_output" >&2
  exit 1
fi

# Set resource and check if GitHub user/organization exists.
if [ -n "${user}" ]; then
  # The /users/{username}/repos endpoint only returns public repositories, even
  # when a token is supplied. To include private repositories, clone from the
  # authenticated-user endpoint /user/repos, which is scoped to the token's own
  # account and returns both public and private repositories.
  resource="user/repos"
  list_params="affiliation=owner&sort=full_name"
  # /user/repos ignores ${user} and always returns the token owner's repos, so
  # verify the token belongs to the requested user before cloning.
  authenticated_user=$(curl -L --silent \
    --header @<(printf 'Authorization: Token %s\n' "${access_token}") \
    "https://api.github.com/user" | jq -r '.login // empty')
  if [ -z "${authenticated_user}" ]; then
    echo "git-clone-gh: could not authenticate with the provided token" >&2
    exit 1
  fi
  if [ "${authenticated_user}" != "${user}" ]; then
    echo "git-clone-gh: token belongs to '${authenticated_user}', not '${user}'" >&2
    echo "git-clone-gh: private repositories are only accessible for the token's own account" >&2
    exit 1
  fi
elif [ -n "${org}" ]; then
  resource="orgs/${org}/repos"
  list_params="type=all&sort=full_name"
  # Authenticate the lookup. An anonymous request shares a 60/hour limit per
  # IP, so back-to-back runs would report a 403 as a missing organization.
  status=$(curl -L --silent --output /dev/null --write-out "%{http_code}" -X GET \
    --header @<(printf 'Authorization: Token %s\n' "${access_token}") \
    "https://api.github.com/orgs/${org}")
  if [ "${status}" -eq 404 ]; then
    echo "git-clone-gh: GitHub organization does not exist" >&2
    exit 1
  elif [ "${status}" -ne 200 ]; then
    echo "git-clone-gh: GitHub organization lookup failed (HTTP ${status})" >&2
    exit 1
  fi
  # Check if resource is protected by organization SAML enforcement.
  status=$(curl -L --silent --output /dev/null --write-out "%{http_code}" -X GET \
    --header @<(printf 'Authorization: Token %s\n' "${access_token}") \
    "https://api.github.com/${resource}")
  if [ "${status}" -eq 403 ]; then
    echo "git-clone-gh: resource protected by organization SAML enforcement" >&2
    echo "git-clone-gh: grant your personal access token access to this organization" >&2
    exit 1
  fi
fi

# Build jq filter based on --skip-archived option.
if [ "${skip_archived}" == true ]; then
  jq_filter='.[] | select(.archived == false) | .ssh_url'
else
  jq_filter='.[].ssh_url'
fi

# The GitHub API only returns 30 results. Therefore, increment page until no
# results are returned.
page=1
ssh_urls=()
while true; do
  response=$(curl -L --silent -X GET \
    --header @<(printf 'Authorization: Token %s\n' "${access_token}") \
    "https://api.github.com/${resource}?${list_params}&page=${page}")

  # If the response is not an array, GitHub returned an error object.
  if ! echo "${response}" | jq -e 'type == "array"' >/dev/null 2>&1; then
    msg=$(echo "${response}" | jq -r '.message // "Unknown error"')
    echo "git-clone-gh: GitHub API error: ${msg}" >&2
    exit 1
  fi

  # Stop on an empty page, not on a page whose repos the filter removed.
  if echo "${response}" | jq -e 'length == 0' >/dev/null; then
    break
  fi
  mapfile -t urls < <(echo "${response}" | jq -r "${jq_filter}")
  ssh_urls+=("${urls[@]}")
  ((page++))
done

filtered=("${ssh_urls[@]}")

if ((${#exclude_patterns[@]} > 0)); then
  pattern="$(printf '%s\n' "${exclude_patterns[@]}" | paste -sd'|' -)"
  mapfile -t filtered < <(printf '%s\n' "${ssh_urls[@]}" | grep -v -E -e "${pattern}")
fi

cloned=()
failed=false

for ssh_url in "${filtered[@]}"; do
  echo Cloning "${ssh_url}"...
  if output=$(git clone "${ssh_url}" 2>&1); then
    cloned+=("$(basename "${ssh_url}" .git)")
  elif echo "${output}" | grep -qi "already exists"; then
    echo -e "${red}Repository already exists.${reset}"
  elif echo "${output}" | grep -qi "not found"; then
    echo -e "${red}Please make sure you have the correct access rights and the repository exists.${reset}"
  elif echo "${output}" | grep -qi "SAML"; then
    echo "git-clone-gh: the '${org}' organization has enabled or enforced SAML SSO" >&2
    echo "git-clone-gh: use the HTTPS remote with a personal access token, or an SSH key authorized for this organization" >&2
    exit 1
  else
    echo "git-clone-gh: clone of ${ssh_url} failed" >&2
    echo "${output}" >&2
    failed=true
  fi
done

if ((${#cloned[@]} > 0)); then
  echo ""
  echo -e "${green}Newly cloned repositories:${reset}"
  for repo in "${cloned[@]}"; do
    echo "  ${repo}"
  done
fi

[ "${failed}" = false ]
