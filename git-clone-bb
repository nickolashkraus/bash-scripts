#!/usr/bin/env bash
#
# DESCRIPTION
#   Clone all Bitbucket repositories for a given project.
#
#   The credentials can be passed via a command-line argument or set via the
#   environment variable BITBUCKET_CREDENTIALS, which keeps them out of the
#   process list and shell history.
#
# USAGE
#   git-clone-bb [OPTIONS] PROJECT_KEY [CREDENTIALS]
#
# ARGUMENTS
#   PROJECT_KEY    Project key for the repository
#   CREDENTIALS    Basic auth credentials (can also be set via BITBUCKET_CREDENTIALS)
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   git-clone-bb ABC xxxxxxxxxx

# Colors
red='\033[0;31m'
green='\033[0;32m'
reset='\033[0m'

# Print usage information.
function usage() {
  echo "usage: git-clone-bb [OPTIONS] PROJECT_KEY [CREDENTIALS]"
  echo ""
  echo "Arguments:"
  echo "  PROJECT_KEY    Project key for the repository"
  echo "  CREDENTIALS    Basic auth credentials (can also be set via BITBUCKET_CREDENTIALS)"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

project_key=""
credentials=""

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "git-clone-bb: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -z "${project_key}" ]; then
        project_key="$1"
      elif [ -z "${credentials}" ]; then
        credentials="$1"
      else
        echo "git-clone-bb: extra argument '$1'" >&2
        usage >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [ -z "${project_key}" ]; then
  echo "git-clone-bb: must specify a project key" >&2
  usage >&2
  exit 1
fi

# If no credentials provided as argument, check environment variable.
if [ -z "${credentials}" ]; then
  credentials="${BITBUCKET_CREDENTIALS}"
fi

if [ -z "${credentials}" ]; then
  echo "git-clone-bb: must provide basic auth credentials" >&2
  usage >&2
  exit 1
fi

resource="https://bitbucket.dwolla.net/rest/api/1.0/projects/${project_key}/repos?limit=2048"

# The server can cap `limit`, so follow `nextPageStart` until the last page.
ssh_urls=()
start=0
while true; do
  if ! response=$(curl -fsS -X GET \
    --header @<(printf 'Authorization: Basic %s\n' "${credentials}") \
    -H "Content-Type: application/json" \
    "${resource}&start=${start}"); then
    echo "git-clone-bb: Bitbucket API request failed" >&2
    exit 1
  fi
  if ! echo "${response}" | jq -e '.values' >/dev/null 2>&1; then
    echo "git-clone-bb: unexpected Bitbucket API response" >&2
    exit 1
  fi
  mapfile -t urls < <(echo "${response}" |
    jq -r '.values[].links.clone[] | select(.name == "ssh") | .href')
  ssh_urls+=("${urls[@]}")
  start=$(echo "${response}" |
    jq -r 'if .isLastPage then empty else .nextPageStart // empty end')
  [ -n "${start}" ] || break
done

cloned=()
failed=false

for ssh_url in "${ssh_urls[@]}"; do
  echo Cloning "${ssh_url}"...
  if output=$(git clone "${ssh_url}" 2>&1); then
    cloned+=("$(basename "${ssh_url}" .git)")
  elif echo "${output}" | grep -qi "already exists"; then
    echo -e "${red}Repository already exists.${reset}"
  else
    echo "git-clone-bb: clone of ${ssh_url} failed" >&2
    echo "${output}" >&2
    failed=true
  fi
done

if ((${#cloned[@]} > 0)); then
  echo ""
  echo -e "${green}Newly cloned repositories:${reset}"
  for repo in "${cloned[@]}"; do
    echo "  ${repo}"
  done
fi

[ "${failed}" = false ]
