#!/usr/bin/env bash
#
# DESCRIPTION
#   Link Bash scripts to $HOME/bin.
#
#   Add the following to your shell configuration file:
#
#     export PATH=$HOME/bin:$PATH
#
#   Link executables to $HOME/bin:
#
#     ./install
#
#   A failed link is reported and counted, but does not abort the rest of the
#   run. The exit status is the number of failed links, so an unattended caller
#   (`system-update`) sees a broken link rather than a silent success.
#
# USAGE
#   install [OPTIONS]
#
# ARGUMENTS
#   None
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   None

# Print usage information.
function usage() {
  echo "usage: install [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

failures=0

# Without $HOME/bin every link below fails, so this one is fatal.
if ! mkdir -p "${HOME}"/bin; then
  echo "ERROR: could not create ${HOME}/bin" >&2
  exit 1
fi

for f in "$(pwd)"/*; do
  # Skip if file a directory.
  [ -d "${f}" ] && continue
  # Skip if file not executable.
  [ ! -x "${f}" ] && continue
  # Skip if file is install script itself.
  [ "$(basename "${f}")" = "install" ] && continue
  # The loop body runs in this shell, so the counter survives the iteration.
  if ! ln -sfn "${f}" "${HOME}/bin/$(basename "${f}")"; then
    echo "ERROR: could not link $(basename "${f}")" >&2
    failures=$((failures + 1))
  fi
done

if [ "${failures}" -ne 0 ]; then
  echo "install: complete, ${failures} failure(s)" >&2
fi

exit "${failures}"
