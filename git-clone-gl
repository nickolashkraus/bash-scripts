#!/usr/bin/env bash
#
# DESCRIPTION
#   Clone all GitLab repositories for a given group.
#
#   There are several ways you can authenticate with the GitLab API. The
#   easiest way is to create a GitLab access token (Settings > Access Tokens >
#   Create personal access token).
#
#   You can use access tokens to authenticate with the API by passing it in
#   either the private_token parameter or the PRIVATE-TOKEN header.
#
#   You can also use personal or project access tokens with OAuth-compliant
#   headers ("Authorization: Bearer <access-token>").
#
#   The access token can be passed via a command-line argument or set via the
#   environment variable GITLAB_API_TOKEN.
#
#   NOTE: This script is specific to Granular.
#
# USAGE
#   git-clone-gl [OPTIONS] GROUP [TOKEN]
#
# ARGUMENTS
#   GROUP    GitLab group
#   TOKEN    GitLab personal access token (can also be set via GITLAB_API_TOKEN)
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   git-clone-gl Group xxxxxxxxxx

# Colors
red='\033[0;31m'
green='\033[0;32m'
reset='\033[0m'

# Print usage information.
function usage() {
  echo "usage: git-clone-gl [OPTIONS] GROUP [TOKEN]"
  echo ""
  echo "Arguments:"
  echo "  GROUP    GitLab group"
  echo "  TOKEN    GitLab personal access token"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

group=""
access_token=""

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "git-clone-gl: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -z "${group}" ]; then
        group="$1"
      elif [ -z "${access_token}" ]; then
        access_token="$1"
      else
        echo "git-clone-gl: extra argument '$1'" >&2
        usage >&2
        exit 1
      fi
      shift
      ;;
  esac
done

if [ -z "${group}" ]; then
  echo "git-clone-gl: must specify a group" >&2
  usage >&2
  exit 1
fi

# If no access token provided as argument, check environment variable.
if [ -z "${access_token}" ]; then
  access_token="${GITLAB_API_TOKEN}"
fi

if [ -z "${access_token}" ]; then
  echo "git-clone-gl: must specify a GitLab access token" >&2
  usage >&2
  exit 1
fi

eval "$(ssh-agent -s)" >/dev/null 2>&1 &&
  ssh-add "${HOME}/.ssh/id_rsa" >/dev/null 2>&1
# The agent holds the decrypted key, so stop it on every exit path.
trap 'ssh-agent -k >/dev/null 2>&1' EXIT

# Test SSH connection to GitLab.
ssh_output=$(ssh -T git@gitlab.internal.granular.ag 2>&1)
if ! echo "$ssh_output" | grep -q "Welcome to GitLab"; then
  echo "git-clone-gl: GitLab SSH authentication failed" >&2
  echo "$ssh_output" >&2
  exit 1
fi

# Encode URL (convert every '/' to '%2F').
group="${group//\//%2F}"

# The GitLab API returns a maximum of 100 results per page. Therefore, we
# increment page until no results are returned.
page=1
ssh_urls=()
while true; do
  response=$(curl -L --silent -X GET \
    --header @<(printf 'Authorization: Bearer %s\n' "${access_token}") \
    "https://gitlab.internal.granular.ag/api/v4/groups/${group}/projects?per_page=100&page=${page}&order_by=name&with_shared=false")

  # If the response is not an array, GitLab returned an error object.
  if ! echo "${response}" | jq -e 'type == "array"' >/dev/null 2>&1; then
    msg=$(echo "${response}" | jq -r '.message // "Unknown error"')
    echo "git-clone-gl: GitLab API error: ${msg}" >&2
    exit 1
  fi

  mapfile -t urls < <(echo "${response}" | jq -r '.[].ssh_url_to_repo')
  # Check if the array is empty or contains only an empty string.
  if [ ${#urls[@]} -eq 0 ] || [ -z "${urls[0]}" ]; then
    break
  fi
  ssh_urls+=("${urls[@]}")
  ((page++))
done

cloned=()
failed=false

for ssh_url in "${ssh_urls[@]}"; do
  echo Cloning "${ssh_url}"...
  if output=$(git clone "${ssh_url}" 2>&1); then
    cloned+=("$(basename "${ssh_url}" .git)")
  elif echo "${output}" | grep -qi "already exists"; then
    echo -e "${red}Repository already exists.${reset}"
  else
    echo "git-clone-gl: clone of ${ssh_url} failed" >&2
    echo "${output}" >&2
    failed=true
  fi
done

if ((${#cloned[@]} > 0)); then
  echo ""
  echo -e "${green}Newly cloned repositories:${reset}"
  for repo in "${cloned[@]}"; do
    echo "  ${repo}"
  done
fi

[ "${failed}" = false ]
