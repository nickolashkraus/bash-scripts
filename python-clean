#!/usr/bin/env bash
#
# DESCRIPTION
#   Remove all Python artifacts in a given directory.
#
# USAGE
#   python-clean [OPTIONS] [DIR]
#
# ARGUMENTS
#   DIR    Directory to use (optional, defaults to current directory)
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   None

# Print usage information.
function usage() {
  echo "usage: python-clean [OPTIONS] [DIR]"
  echo ""
  echo "Arguments:"
  echo "  DIR    Directory to use (optional, defaults to current directory)"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

dir=""

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "python-clean: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      dir="$1"
      shift
      break
      ;;
  esac
done

if [ -z "${dir}" ]; then
  dir="$(pwd)"
else
  if [ ! -e "${dir}" ]; then
    echo "python-clean: ${dir} does not exist" >&2
    exit 1
  fi
fi

status=0

# Run find from the current directory, skipping virtual environments (.venv,
# venv, .tox), .git and node_modules at any depth, whose contents belong to
# installed packages, not this project's build. A failure marks the run as
# failed.
function find_artifacts() {
  find . \( -name .venv -o -name venv -o -name .tox -o -name .git \
    -o -name node_modules \) -prune -o "$@" || status=1
}

# Remove a top-level directory. -type d does not match a symlink, so a
# symlink with this name, and whatever it points to, is left alone.
function remove_dir() {
  find . -maxdepth 1 -name "$1" -type d -exec rm -fr {} + || status=1
}

function python_clean() {
  # Remove build artifacts.
  find_artifacts -name '*.egg' -exec rm -fr {} +
  find_artifacts -name '*.egg-info' -exec rm -fr {} +
  remove_dir .eggs
  remove_dir build
  remove_dir dist
  # Remove Python artifacts.
  find_artifacts -name '*.pyc' -exec rm -f {} +
  find_artifacts -name '*.pyo' -exec rm -f {} +
  find_artifacts -name '*~' -exec rm -f {} +
  find_artifacts -name '__pycache__' -exec rm -fr {} +
  # Remove test and coverage artifacts.
  find_artifacts -name '*,cover' -exec rm -f {} +
  find_artifacts -name '.coverage' -exec rm -f {} +
  find_artifacts -name '.pytest_cache' -exec rm -fr {} +
  remove_dir cover
  find_artifacts -name 'coverage.xml' -exec rm -f {} +
  find_artifacts -name 'htmlcov' -exec rm -fr {} +
}

pushd "${dir}" >/dev/null || exit
python_clean
popd >/dev/null || exit
exit "${status}"
