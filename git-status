#!/usr/bin/env bash
#
# DESCRIPTION
#   Show the status for all Git repositories for a given directory.
#
# USAGE
#   git-status [OPTIONS] [DIR]
#
# ARGUMENTS
#   DIR    Directory to use (optional, defaults to current directory)
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   None

# Colors
red='\033[0;31m'
green='\033[0;32m'
yellow='\033[0;33m'
reset='\033[0m'

# Print usage information.
function usage() {
  echo "usage: git-status [OPTIONS] [DIR]"
  echo ""
  echo "Arguments:"
  echo "  DIR    Directory to use (optional, defaults to current directory)"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

dir=""

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "git-status: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -n "${dir}" ]; then
        echo "git-status: extra argument '$1'" >&2
        usage >&2
        exit 1
      fi
      dir="$1"
      shift
      ;;
  esac
done

if [ -z "${dir}" ]; then
  dir="$(pwd)"
else
  if [ ! -d "${dir}" ]; then
    echo "git-status: ${dir} is not a directory" >&2
    exit 1
  fi
fi

function do_status() {
  local output
  if ! output=$(git status --porcelain=v2 --branch 2>&1); then
    echo "git-status: ${output}" >&2
    return
  fi
  # Porcelain v2 marks tracked changes with 1, 2 or u, untracked files with ?,
  # and commits ahead of the upstream with `# branch.ab +N`.
  if grep -q '^[12u] ' <<<"${output}"; then
    echo -e "${red}Modified files${reset}"
  elif grep -q '^? ' <<<"${output}"; then
    echo -e "${red}Untracked files${reset}"
  elif grep -q '^# branch\.ab +[1-9]' <<<"${output}"; then
    echo -e "${yellow}Use \"git push\" to publish your local commits${reset}"
  else
    echo -e "${green}Working tree clean${reset}"
  fi
}

for d in "${dir}"/*; do
  [ -d "${d}" ] || continue
  basename "${d}"

  # Bare repository (worktree container).
  if [ "$(git -C "${d}" rev-parse --is-bare-repository 2>/dev/null)" = "true" ]; then
    for w in "${d}"/*; do
      [ -d "${w}" ] || continue
      [ -f "${w}/.git" ] || continue
      echo "  $(basename "${w}")"
      pushd "${w}" >/dev/null || exit
      do_status
      popd >/dev/null || exit
    done
    continue
  fi

  # Regular clone.
  if [ ! -d "${d}/.git" ]; then
    echo -e "${red}$(basename "${d}") is not a Git repository.${reset}"
    continue
  fi

  pushd "${d}" >/dev/null || exit
  do_status
  popd >/dev/null || exit
done
