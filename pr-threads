#!/usr/bin/env bash
#
# DESCRIPTION
#   List and resolve pull request review threads without opening a browser.
#
#   `gh` has no command for this, so it goes through the GraphQL mutations
#   resolveReviewThread and unresolveReviewThread. Numbers come from the
#   listing, which is cached per pull request in the worktree's gitdir, so
#   `--resolve` acts on exactly what was printed.
#
#   `replied` is the one to reach for after a round of bot review: it resolves
#   only the threads that already carry an answer from you, and leaves
#   anything still unanswered alone.
#
#   Only the first 100 threads and the first 50 comments in each are read.
#
#   Environment:
#     PR_THREADS_ASSUME_YES=1    Resolve without the confirmation prompt
#
# USAGE
#   pr-threads [OPTIONS] [PR]
#
# ARGUMENTS
#   PR    Pull request number, URL, or branch (optional, defaults to the current
#         worktree's pull request)
#
# OPTIONS
#   --all                    List resolved threads too
#   --resolve SELECTOR       Resolve by listing number (e.g., 2,5), 'replied'
#                            (every thread you answered), or 'all'
#   --unresolve SELECTOR     Put threads back, selected the same way
#   -h, --help               Show this help message
#
# EXAMPLES
#   pr-threads
#   pr-threads --all 1234
#   pr-threads --resolve 2,5
#   pr-threads --resolve replied

# Print usage information.
function usage() {
  echo "usage: pr-threads [OPTIONS] [PR]"
  echo ""
  echo "Arguments:"
  echo "  PR    Pull request number, URL, or branch (optional, defaults to the current"
  echo "        worktree's pull request)"
  echo ""
  echo "Options:"
  echo "  --all                    List resolved threads too"
  echo "  --resolve SELECTOR       Resolve by listing number (e.g., 2,5), 'replied'"
  echo "                           (every thread you answered), or 'all'"
  echo "  --unresolve SELECTOR     Put threads back, selected the same way"
  echo "  -h, --help               Show this help message"
  echo ""
}

# Prompt for a single y/n keystroke. Succeeds only on y or Y.
function confirm() {
  local reply
  read -r -n 1 -p "$1 [y/N] " reply
  echo
  [[ ${reply} == [yY] ]]
}

mode="list"
selector=""
target=()

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    --all)
      mode="list_all"
      shift
      ;;
    --resolve | --unresolve)
      mode=${1#--}
      if [[ -z $2 ]]; then
        echo "pr-threads: ${mode} needs numbers, 'replied', or 'all'" >&2
        exit 1
      fi
      selector=$2
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      if [[ ${#target[@]} -gt 0 ]]; then
        echo "Unknown argument: $1" >&2
        usage
        exit 1
      fi
      target=("$1")
      shift
      ;;
  esac
done

gitdir=$(git rev-parse --git-dir 2>/dev/null) || {
  echo "pr-threads: not a git repository" >&2
  exit 1
}

# The owner and repo come from the pull request's URL rather than the current
# directory, so a URL for some other repository lists that repository's threads.
meta=$(gh pr view "${target[@]}" --json number,url --jq '[.number, .url] | @tsv' 2>/dev/null) || {
  echo "pr-threads: no pull request found; pass a number or URL" >&2
  exit 1
}
IFS=$'\t' read -r number url <<<"${meta}"
nwo=${url#https://github.com/}
nwo=${nwo%/pull/*}
owner=${nwo%%/*}
repo=${nwo#*/}

cache="${gitdir}/pr-threads.${owner}.${repo}.${number}.tsv"
me=$(gh api user --jq .login)
if [[ -z ${me} ]]; then
  echo "pr-threads: could not read your GitHub login" >&2
  exit 1
fi

if [[ ${mode} == list || ${mode} == list_all ]]; then
  # The `$` names are GraphQL variables, not shell ones.
  # shellcheck disable=SC2016
  gh api graphql -F owner="${owner}" -F repo="${repo}" -F pr="${number}" -f query='
    query($owner:String!, $repo:String!, $pr:Int!) {
      repository(owner:$owner, name:$repo) { pullRequest(number:$pr) {
        reviewThreads(first:100) { nodes {
          id isResolved isOutdated path line
          comments(first:50) { nodes { author { login } body } } } } } } }' \
    --jq '.data.repository.pullRequest.reviewThreads.nodes[] | [
            .id, (.isResolved|tostring), (.isOutdated|tostring),
            (.path // "-"), ((.line // 0)|tostring),
            (.comments.nodes[0].author.login // "-"),
            ([.comments.nodes[].author.login] | join(",")),
            ((.comments.nodes[0].body | split("\n")
               | map(select(length > 0 and (startswith("<!--") | not)))
               | (map(select(startswith("**"))) + .) | .[0]) // "")
          ] | @tsv' >"${cache}" || exit 1

  MODE=${mode} ME=${me} python3 - "${cache}" <<'PY'
import os, sys
from pathlib import Path

rows = [l.split("\t") for l in Path(sys.argv[1]).read_text().splitlines() if l.strip()]
show_all = os.environ["MODE"] == "list_all"
me = os.environ["ME"]
shown = 0
for i, r in enumerate(rows, 1):
    _id, resolved, outdated, path, line, author, participants, title = (r + [""] * 8)[:8]
    if resolved == "true" and not show_all:
        continue
    shown += 1
    flags = "resolved" if resolved == "true" else "open"
    if outdated == "true":
        flags += ",outdated"
    if me in participants.split(",")[1:]:
        flags += ",replied"
    title = title.lstrip("# ").strip()
    if len(title) > 78:
        title = title[:77] + "…"
    where = f"{path}:{line}" if line != "0" else path
    print(f"{i:>3}  {flags:<22}  {author:<12}  {where}")
    print(f"     {title}")
if not shown:
    print("No unresolved threads." if not show_all else "No threads.")
PY
  exit 0
fi

[[ -f ${cache} ]] || {
  echo "pr-threads: run the listing first so the numbers mean something" >&2
  exit 1
}

mutation="resolveReviewThread"
[[ ${mode} == unresolve ]] && mutation="unresolveReviewThread"

ids=()
labels=()
idx=0
while IFS=$'\t' read -r tid resolved _outdated tpath tline _tauthor tparts _ttitle; do
  idx=$((idx + 1))
  want=0
  case ${selector} in
    all)
      [[ ${resolved} == false ]] && want=1
      ;;
    replied)
      [[ ${resolved} == false ]] || continue
      # The first comment is the bot's; a later one from you is the answer.
      [[ ",${tparts}," == *",${me},"* && ${tparts%%,*} != "${me}" ]] && want=1
      ;;
    *)
      [[ ",${selector}," == *",${idx},"* ]] && want=1
      ;;
  esac
  if [[ ${want} -eq 1 ]]; then
    ids+=("${tid}")
    labels+=("${idx} ${tpath}:${tline}")
  fi
done <"${cache}"

if [[ ${#ids[@]} -eq 0 ]]; then
  echo "pr-threads: nothing matched '${selector}'."
  exit 0
fi

echo "About to ${mode} ${#ids[@]} thread(s) on #${number}:"
for l in "${labels[@]}"; do
  echo "  ${l}"
done
if [[ -z ${PR_THREADS_ASSUME_YES} ]]; then
  if [[ ! -t 0 ]]; then
    echo "pr-threads: no terminal to confirm on; set PR_THREADS_ASSUME_YES=1" >&2
    exit 1
  fi
  confirm "Continue?" || exit 1
fi

ok=0
failed=0
for id in "${ids[@]}"; do
  if gh api graphql -F id="${id}" -f query="
    mutation(\$id:ID!) { ${mutation}(input:{threadId:\$id}) { thread { isResolved } } }" \
    --jq ".data.${mutation}.thread.isResolved" >/dev/null 2>&1; then
    ok=$((ok + 1))
  else
    failed=$((failed + 1))
    echo "pr-threads: ${mutation} failed for ${id}" >&2
  fi
done

summary="pr-threads: ${mode}d ${ok} thread(s) on #${number}"
[[ ${failed} -gt 0 ]] && summary+=", ${failed} failed"
echo "${summary}"
[[ ${failed} -eq 0 ]]
