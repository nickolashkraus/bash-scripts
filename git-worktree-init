#!/usr/bin/env bash
#
# DESCRIPTION
#   Convert a regular Git clone into a bare repository with a worktree for the
#   default branch. This enables the bare-clone container pattern where each
#   branch is a peer worktree directory.
#
#   The original clone is deleted unless it holds something the conversion
#   does not copy: ignored files, stash entries, local tags, hooks, local
#   config, linked worktrees, submodules, LFS objects or .git/info/exclude
#   patterns. Then it is kept beside the new layout as REPO-worktree-tmp-PID
#   and the script lists what it holds. A local user.name and user.email are
#   copied to the bare repository, so they do not count.
#
# USAGE
#   git-worktree-init [OPTIONS] REPO
#
# ARGUMENTS
#   REPO    Path to the Git repository to convert
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   git-worktree-init example-service
#   git-worktree-init ~/src/example-service

# Colors
green='\033[0;32m'
reset='\033[0m'

# Print usage information.
function usage() {
  echo "usage: git-worktree-init [OPTIONS] REPO"
  echo ""
  echo "Arguments:"
  echo "  REPO    Path to the Git repository to convert"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

repo=""

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "git-worktree-init: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      repo="$1"
      shift
      break
      ;;
  esac
done

if [ -z "${repo}" ]; then
  echo "git-worktree-init: specify a repository to convert" >&2
  usage >&2
  exit 1
fi

# Remove trailing slash.
repo="${repo%/}"

if [ ! -d "${repo}" ]; then
  echo "git-worktree-init: ${repo} does not exist" >&2
  exit 1
fi

if [ ! -d "${repo}/.git" ]; then
  if [ "$(git -C "${repo}" rev-parse --is-bare-repository 2>/dev/null)" = "true" ]; then
    echo "git-worktree-init: ${repo} is already a bare repository" >&2
  elif [ -f "${repo}/.git" ]; then
    echo "git-worktree-init: ${repo} is a linked worktree or submodule, not a clone" >&2
  else
    echo "git-worktree-init: ${repo} is not a Git repository" >&2
  fi
  exit 1
fi

cd "${repo}" || exit 1
repo_abs=$(pwd)
repo_parent=$(dirname "${repo_abs}")
repo_name=$(basename "${repo_abs}")

# Check for uncommitted changes.
if [ -n "$(git status --porcelain)" ]; then
  echo "git-worktree-init: uncommitted changes; commit or stash first" >&2
  exit 1
fi

# Check for unpushed commits.
unpushed=$(git log --branches --not --remotes --oneline 2>/dev/null)
if [ -n "${unpushed}" ]; then
  echo "git-worktree-init: unpushed commits; push all branches first" >&2
  exit 1
fi

# Get remote URL.
remote_url=$(git remote get-url origin 2>/dev/null)
if [ -z "${remote_url}" ]; then
  echo "git-worktree-init: no 'origin' remote found" >&2
  exit 1
fi

# Determine the default branch.
default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
if [ -z "${default_branch}" ]; then
  if git show-ref --verify --quiet refs/heads/master 2>/dev/null; then
    default_branch="master"
  elif git show-ref --verify --quiet refs/heads/main 2>/dev/null; then
    default_branch="main"
  else
    echo "git-worktree-init: cannot determine default branch" >&2
    exit 1
  fi
fi

cd "${repo_parent}" || exit 1

# Move existing clone to a temporary location.
tmp="${repo_name}-worktree-tmp-$$"
if ! mv "${repo_name}" "${tmp}"; then
  echo "git-worktree-init: cannot move ${repo_name} aside" >&2
  exit 1
fi

# Clone as a bare repository.
if ! git clone --bare "${remote_url}" "${repo_name}"; then
  echo "git-worktree-init: bare clone failed; restoring the original" >&2
  rm -rf "${repo_name}"
  mv "${tmp}" "${repo_name}"
  exit 1
fi

cd "${repo_name}" || exit 1

# Replace the bare clone with the original and exit.
function restore() {
  echo "git-worktree-init: $1; restoring the original" >&2
  cd "${repo_parent}" || exit 1
  rm -rf "${repo_name}"
  mv "${tmp}" "${repo_name}" ||
    echo "git-worktree-init: the original is at ${repo_parent}/${tmp}" >&2
  exit 1
}

# Fix the fetch refspec for worktree compatibility. By default, bare clones
# map remote branches to local refs. This restores the standard remote
# tracking layout so that git pull works inside worktrees.
git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
git fetch origin >/dev/null 2>&1 || restore "fetch failed"

# Add a worktree for the default branch and set up tracking.
git worktree add "${default_branch}" "${default_branch}" >/dev/null 2>&1 ||
  restore "cannot add the '${default_branch}' worktree"
git -C "${default_branch}" branch -u "origin/${default_branch}" >/dev/null 2>&1 ||
  restore "cannot set the upstream of '${default_branch}'"

orig="${repo_parent}/${tmp}"
new="${repo_parent}/${repo_name}"

# Every worktree shares the bare repository's config, so give it the identity
# set on the original (git-config-all sets one on every clone it visits).
for key in user.name user.email; do
  value=$(git -C "${orig}" config --local --get "${key}") &&
    git config "${key}" "${value}"
done

# Print what the original holds that the conversion did not copy, one item
# per line, or a line naming a check that could not run. Config values are
# left out, since they can hold credentials.
function held() (
  set -o pipefail
  cd "${orig}" || {
    echo "unchecked: ${orig}"
    exit
  }
  git status --porcelain --ignored | sed -n 's/^!! /ignored: /p' ||
    echo "unchecked: ignored files"
  git stash list | sed 's/^/stash: /' || echo "unchecked: stash"
  git for-each-ref --format='%(refname) %(objectname)' refs/tags |
    while read -r ref sha; do
      [ "$(git -C "${new}" rev-parse -q --verify "${ref}")" = "${sha}" ] ||
        echo "tag: ${ref#refs/tags/}"
    done || echo "unchecked: tags"
  if [ -d .git/hooks ]; then
    find .git/hooks -type f ! -name '*.sample' | sed 's#.*/#hook: #' ||
      echo "unchecked: hooks"
  fi
  # The first entry is the original clone itself.
  git worktree list --porcelain | sed -n '1d; s/^worktree /worktree: /p' ||
    echo "unchecked: worktrees"
  { [ -s .gitmodules ] || [ -n "$(ls -A .git/modules 2>/dev/null)" ]; } &&
    echo "submodules: .gitmodules or .git/modules"
  [ -n "$(find .git/lfs -type f 2>/dev/null)" ] && echo "lfs: .git/lfs"
  grep -qv '^#\|^[[:space:]]*$' .git/info/exclude 2>/dev/null &&
    echo "exclude: .git/info/exclude"
  # core.bare and core.logallrefupdates differ only because the new repository
  # is bare, branch tracking is set up again in each worktree, and submodule
  # settings are reported with the submodules above.
  git config --local --list |
    sed -E '/^(core\.(bare|logallrefupdates)|branch\..*\.(remote|merge)|submodule\..*)=/d' |
    while IFS= read -r line; do
      git -C "${new}" config --local --list | grep -qxF -- "${line}" ||
        echo "config: ${line%%=*}"
    done || echo "unchecked: config"
)

echo -e "${green}Converted ${repo_name} to bare clone with '${default_branch}' worktree.${reset}"

left=$(held)
if [ -z "${left}" ]; then
  rm -rf "${orig}"
else
  echo "git-worktree-init: kept the original clone at ${orig}, which holds what the conversion did not copy:" >&2
  while IFS= read -r line; do
    echo "  ${line}" >&2
  done <<<"${left}"
fi
