#!/usr/bin/env bash
#
# DESCRIPTION
#   Spawn a new tmux session for a vertical display.
#   Creates a session using the name of the current directory with three panes
#   in a vertical layout.
#
#   NOTE: This script is specific to my local development environment.
#
# USAGE
#   tmux-new-v [OPTIONS]
#
# ARGUMENTS
#   None
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   None

# Print usage information.
function usage() {
  echo "usage: tmux-new-v [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "tmux-new-v: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "tmux-new-v: unknown argument '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ! [ -x "$(command -v tmux)" ]; then
  echo "tmux-new-v: tmux is not installed" >&2
  exit 1
fi

function tmux_new_v() {
  BASE_NAME="$(basename "$(pwd)")"
  i=0
  while tmux has-session -t "${BASE_NAME}-${i}" 2>/dev/null; do
    i=$((i + 1))
  done
  SESSION_NAME="${BASE_NAME}-${i}"

  # Inside tmux, attach-session refuses to nest, so switch to the session.
  ATTACH="attach-session"
  if [[ -n "${TMUX:-}" ]]; then
    ATTACH="switch-client"
  fi

  # Name the new session in every command: inside tmux, a command without
  # -t acts on the current client's window, not the new session. "S:" is
  # the session's current window and "S:.N" is pane N in it.
  tmux new-session -d -s "${SESSION_NAME}" \; \
    split-window -v -t "${SESSION_NAME}:" \; \
    split-window -v -t "${SESSION_NAME}:" \; \
    select-layout -t "${SESSION_NAME}:" 'ba62,308x253,0,0[308x36,0,0,8,308x152,0,37,10,308x63,0,190,9]' \; \
    select-pane -t "${SESSION_NAME}:.1" \; \
    "${ATTACH}" -t "${SESSION_NAME}"
}

tmux_new_v
