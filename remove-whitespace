#!/usr/bin/env bash
#
# DESCRIPTION
#   Remove trailing whitespace from every file in a given directory.
#   Excludes binary files, Git metadata, node_modules/ and .venv/.
#
# USAGE
#   remove-whitespace [OPTIONS] [DIR]
#
# ARGUMENTS
#   DIR    Directory to use (optional, defaults to current directory)
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   None

# Print usage information.
function usage() {
  echo "usage: remove-whitespace [OPTIONS] [DIR]"
  echo ""
  echo "Arguments:"
  echo "  DIR    Directory to use (optional, defaults to current directory)"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

dir=""

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "remove-whitespace: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      dir="$1"
      shift
      break
      ;;
  esac
done

if [ -z "${dir}" ]; then
  dir="$(pwd)"
else
  if [ ! -e "${dir}" ]; then
    echo "remove-whitespace: ${dir} does not exist" >&2
    exit 1
  fi
fi

if ! [ -x "$(command -v gsed)" ]; then
  echo "remove-whitespace: gsed is not installed" >&2
  exit 1
fi

function remove_whitespace() {
  local failed
  # Skip Git metadata: a .git directory, a worktree's .git file and any bare
  # repository (a directory with HEAD, objects and refs). find ignores the
  # exit status of -exec ... \;, so print the files gsed fails on and fail
  # when there are any.
  failed=$(find . \
    \( -name .git -o -name node_modules -o -name .venv \) -prune -o \
    -type d -exec test -f {}/HEAD -a -d {}/objects -a -d {}/refs \; -prune -o \
    -type f \
    -name "*" \
    -not -name "*.png" \
    -exec grep -Iq . {} \; \
    ! -exec gsed -i 's/[[:space:]]\+$//' {} \; \
    -print) || return
  [ -z "${failed}" ]
}

if [ -f "${dir}/HEAD" ] && [ -d "${dir}/objects" ] && [ -d "${dir}/refs" ]; then
  echo "remove-whitespace: ${dir} is a Git directory" >&2
  exit 1
fi

pushd "${dir}" >/dev/null || exit
remove_whitespace
status=$?
popd >/dev/null || exit
exit "${status}"
