#!/usr/bin/env bash
#
# DESCRIPTION
#   Create a URL slug from a string.
#   The string to slugify is retrieved from the Clipboard.
#
# USAGE
#   slugify [OPTIONS]
#
# ARGUMENTS
#   None
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   None

# Print usage information.
function usage() {
  echo "usage: slugify [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "slugify: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "slugify: unknown argument '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ! [ -x "$(command -v pbcopy)" ]; then
  echo "slugify: pbcopy is not installed" >&2
  exit 1
fi

if ! [ -x "$(command -v pbpaste)" ]; then
  echo "slugify: pbpaste is not installed" >&2
  exit 1
fi

# This command will do the following:
# 1. Join lines into one
# 2. Change all characters to lowercase
# 3. Convert whitespace to hyphens ('-')
# 4. Remove every character other than letters, digits, '.', '_' and '-'
# 5. Deduplicate hyphens ('--' >>> '-') and trim leading and trailing ones
# 6. Remove trailing newline ('\n')
pbpaste |
  tr '\n' ' ' |
  perl -CSD -pe '$_ = lc; s/\s+/-/g; s/[^\w.-]//g; s/-{2,}/-/g; s/^-+|-+$//g' |
  tr -d '\n' |
  pbcopy
