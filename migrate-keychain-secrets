#!/usr/bin/env bash
#
# DESCRIPTION
#   Generate a keychain-migration script for a new Mac and place it on the
#   clipboard. The generated script re-creates each secret in the new
#   machine's Login Keychain via `security add-generic-password`.
#
#   NOTE: This script is specific to my setup. It copies every entry under
#   the `function-health` and `personal` accounts, plus `workmail`, whose
#   account is its login email. Each entry keeps its kind and comment.
#
#   Secret values live only in the clipboard, never on disk or in terminal
#   output. With Universal Clipboard (same iCloud account, Macs nearby),
#   the payload is available on the new Mac immediately. On the new Mac,
#   run `pbpaste | bash` rather than pasting into the prompt, so values
#   never hit the terminal scrollback or shell history. The generated
#   script clears the new Mac's clipboard when it finishes; clear this
#   machine's clipboard afterward with `pbcopy < /dev/null`.
#
#   WARNING: Clipboard managers on either Mac will capture the payload.
#   Pause or purge them before running.
#
# USAGE
#   migrate-keychain-secrets [OPTIONS]
#
# ARGUMENTS
#   None
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   migrate-keychain-secrets

set -euo pipefail

# Print "service<TAB>account" for each entry to migrate.
function entries() {
  security dump-keychain | awk '
    function value(line) { sub(/^[^=]*="/, "", line); sub(/"$/, "", line); return line }
    function flush() {
      if (genp && (acct == "function-health" || acct == "personal" || svce == "workmail"))
        printf "%s\t%s\n", svce, acct
    }
    /^keychain:/ { flush(); genp = 0; svce = ""; acct = "" }
    /^class: "genp"/ { genp = 1 }
    /^ *"svce"<blob>="/ { svce = value($0) }
    /^ *"acct"<blob>="/ { acct = value($0) }
    END { flush() }'
}

# Print one attribute (desc, icmt) from `find-generic-password` output.
function attr() {
  sed -n "s/^ *\"$2\"<blob>=\"\(.*\)\"\$/\1/p" <<<"$1"
}

# Print usage information.
function usage() {
  echo "usage: migrate-keychain-secrets [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "migrate-keychain-secrets: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      echo "migrate-keychain-secrets: unknown argument '$1'" >&2
      usage >&2
      exit 1
      ;;
  esac
done

count=$(entries | wc -l | tr -d ' ')

{
  echo 'set -euo pipefail'
  while IFS=$'\t' read -r s a; do
    attrs=$(security find-generic-password -s "${s}" -a "${a}")
    v=$(security find-generic-password -s "${s}" -a "${a}" -w)
    printf 'security add-generic-password -s %q -a %q -D %q -j %q -U -w %q\n' \
      "${s}" "${a}" "$(attr "${attrs}" desc)" "$(attr "${attrs}" icmt)" "${v}"
  done < <(entries)
  printf 'echo "Imported %s entries. Clearing clipboard."\n' "${count}"
  echo 'pbcopy < /dev/null'
} | pbcopy

echo "Migration script for ${count} entries is on the clipboard."
echo "On the new Mac, run: pbpaste | bash"
echo "Afterward, clear this Mac's clipboard: pbcopy < /dev/null"
