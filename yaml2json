#!/usr/bin/env bash
#
# DESCRIPTION
#   Convert YAML to JSON.
#
# USAGE
#   yaml2json [OPTIONS] FILE
#
# ARGUMENTS
#   FILE    Path to YAML file
#
# OPTIONS
#   -h, --help    Show this help message
#
# EXAMPLES
#   None

# Print usage information.
function usage() {
  echo "usage: yaml2json [OPTIONS] FILE"
  echo ""
  echo "Arguments:"
  echo "  FILE    Path to YAML file"
  echo ""
  echo "Options:"
  echo "  -h, --help    Show this help message"
  echo ""
}

file=""

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "yaml2json: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      file="$1"
      shift
      break
      ;;
  esac
done

if [ -z "${file}" ]; then
  echo "yaml2json: must specify a file" >&2
  usage >&2
  exit 1
fi

if [ ! -e "${file}" ]; then
  echo "yaml2json: ${file} does not exist" >&2
  exit 1
fi

filename=$(echo "${file}" | cut -f 1 -d '.')

python_script=$(
  cat <<END
import sys;
import json;
import yaml;

json.dump(yaml.safe_load(sys.stdin), sys.stdout, indent=2)

END
)

python -c "${python_script}" <"${file}" >"${filename}.json"
