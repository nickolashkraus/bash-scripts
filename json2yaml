#!/usr/bin/env bash
#
# DESCRIPTION
#   Convert JSON to YAML. Keys are sorted unless --keep-order is given.
#
#   Requires uv, which supplies PyYAML in a throwaway environment, so PyYAML
#   need not be installed.
#
# USAGE
#   json2yaml [OPTIONS] FILE
#
# ARGUMENTS
#   FILE    Path to JSON file
#
# OPTIONS
#   -k, --keep-order    Keep the key order of the JSON file
#   -h, --help          Show this help message
#
# EXAMPLES
#   json2yaml config.json
#   json2yaml --keep-order config.json

# Print usage information.
function usage() {
  echo "usage: json2yaml [OPTIONS] FILE"
  echo ""
  echo "Arguments:"
  echo "  FILE    Path to JSON file"
  echo ""
  echo "Options:"
  echo "  -k, --keep-order    Keep the key order of the JSON file"
  echo "  -h, --help          Show this help message"
  echo ""
}

file=""
sort_keys="True"

# Parse command line arguments.
while [[ $# -gt 0 ]]; do
  case $1 in
    -k | --keep-order)
      sort_keys="False"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      echo "json2yaml: unknown option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -n "${file}" ]; then
        echo "json2yaml: unknown argument '$1'" >&2
        usage >&2
        exit 1
      fi
      file="$1"
      shift
      ;;
  esac
done

if [ -z "${file}" ]; then
  echo "json2yaml: must specify a file" >&2
  usage >&2
  exit 1
fi

if [ ! -e "${file}" ]; then
  echo "json2yaml: ${file} does not exist" >&2
  exit 1
fi

filename="${file}"
if [[ ${file##*/} == *.* ]]; then
  filename="${file%.*}"
fi

python_script=$(
  cat <<END
import sys;
import json;
import yaml;

yaml.safe_dump(json.load(sys.stdin), sys.stdout, default_flow_style=False, sort_keys=${sort_keys})

END
)

if ! command -v uv >/dev/null 2>&1; then
  echo "json2yaml: uv is not installed" >&2
  exit 1
fi

# Convert before writing, so a failed conversion leaves an existing output
# file untouched. printf ends the output with a newline.
# --no-project keeps a pyproject.toml in the current directory out of it.
output=$(uv run --quiet --no-project --with pyyaml python -c "${python_script}" <"${file}") || exit
printf '%s\n' "${output}" >"${filename}.yaml"
