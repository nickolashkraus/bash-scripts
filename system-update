#!/usr/bin/env bash
#
# DESCRIPTION
#   Keep the local system up to date. Runs the daily maintenance sequence as a
#   single self-contained job so it can be driven unattended by launchd.
#
#   Runs the following, isolating each step so one failure does not abort the
#   rest:
#     1. vim plugin clean/install/update (vim-plug)
#     2. brew update && brew upgrade --yes
#     3. pipx upgrade-all && uv tool upgrade --all
#     4. fh-sync for each Function Health GitHub organization
#     5. git-pull in ~/nickolashkraus
#     6. bash-scripts install
#     7. dotfiles install
#     8. worktree-links
#
#   The two install steps run last so they act on the revisions the git-pull
#   step just fetched. Each repo owns what its own install does; both are
#   idempotent and safe to re-run daily. worktree-links runs after git-pull,
#   so it uses the fetched revision.
#
#   The script is environment-independent: it sets its own PATH (launchd jobs
#   inherit no shell env) and reads FH_GITHUB_TOKEN from the Login Keychain
#   rather than an interactive shell export.
#
#   With the lid closed on battery the Mac sleeps within seconds whatever
#   assertion is held, and the run only advances in short dark wakes, so every
#   step but worktree-links is skipped and reported as skipped, not failed.
#   --force runs them anyway. If the lid or the power source cannot be read,
#   every step runs.
#
# USAGE
#   system-update [OPTIONS]
#
# ARGUMENTS
#   None
#
# OPTIONS
#   --force       Run every step, even with the lid closed on battery
#   -h, --help    Show this help message
#
# EXAMPLES
#   system-update
#   system-update --force
#   launchctl kickstart -k gui/$(id -u)/io.nickolaskraus.system-update

set -uo pipefail

# Colors
green='\033[0;32m'
red='\033[0;31m'
reset='\033[0m'

# launchd starts jobs with a minimal PATH and no shell profile. Set the PATH
# the steps need explicitly (Homebrew, ~/bin symlinks, system utilities).
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:${HOME}/bin:${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# Quiet Homebrew: no environment hints, no cleanup after each upgrade.
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1

failures=0
skipped=0
skip_network=false

function usage() {
  echo "usage: system-update [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  --force       Run every step, even with the lid closed on battery"
  echo "  -h, --help    Show this help message"
  echo ""
}

# Succeed only when the lid is closed and the Mac draws from its battery.
# A check that cannot run, or prints something else, counts as no.
function lid_closed_on_battery() {
  local lid power
  lid=$(ioreg -r -k AppleClamshellState -d 1 2>/dev/null) || return 1
  power=$(pmset -g batt 2>/dev/null) || return 1
  [[ ${lid} == *'"AppleClamshellState" = Yes'* ]] &&
    [[ ${power} == *"Now drawing from 'Battery Power'"* ]]
}

# Run a labeled step. Logs a header and the outcome; a non-zero exit is
# recorded but never aborts the remaining steps.
#
# Steps are passed as function names, so shellcheck cannot see the call site
# and reports each step function as never invoked. Hence the SC2329 directives
# below.
function run_step() {
  local label="$1"
  shift
  echo ""
  echo -e "${green}==> ${label}${reset}"
  if "$@"; then
    echo -e "${green}==> ${label}: OK${reset}"
  else
    local status=$?
    echo -e "${red}==> ${label}: FAILED (exit ${status})${reset}"
    ((failures++))
  fi
}

# Run a step that needs the network, or report it skipped.
function network_step() {
  if [ "${skip_network}" = true ]; then
    echo ""
    echo -e "${green}==> $1: SKIPPED (lid closed on battery)${reset}"
    ((skipped++))
    return
  fi
  run_step "$@"
}

# shellcheck disable=SC2329
function update_vim() {
  # PlugClean! (bang) skips the interactive confirmation prompt, which would
  # otherwise hang with no TTY. Input is redirected from /dev/null so vim never
  # blocks on a prompt. --not-a-term drops the "Output is not to a terminal"
  # warning and, more usefully, the two second delay vim adds after it, which
  # this function would otherwise pay three times per run. It does not quiet
  # vim-plug's redraws; the log still collects the escape sequences they emit.
  vim --not-a-term +PlugClean! +qall </dev/null &&
    vim --not-a-term +PlugInstall +qall </dev/null &&
    vim --not-a-term +PlugUpdate +qall </dev/null
}

# shellcheck disable=SC2329
function update_brew() {
  brew update && brew upgrade --yes
}

# Brew upgrades pipx and uv themselves, but not the tools they manage (ruff,
# mypy, poetry via pipx; keyring, fh-internal-deps via uv). Run both upgrades
# even if one fails so a single broken package cannot stall the other manager.
# shellcheck disable=SC2329
function update_python_tools() {
  local status=0
  pipx upgrade-all || status=1
  uv tool upgrade --all || status=1
  return "${status}"
}

# shellcheck disable=SC2329
function sync_org() {
  local org="$1"
  cd "${HOME}/${org}" && fh-sync "${org}"
}

# shellcheck disable=SC2329
function pull_personal() {
  cd "${HOME}/nickolashkraus" && git-pull
}

# Each install script is invoked from its own worktree, since an installer may
# resolve what it installs relative to the working directory. Input is
# redirected from /dev/null so an installer that prompts cannot block the run.
# shellcheck disable=SC2329
function install_bash_scripts() {
  cd "${HOME}/nickolashkraus/bash-scripts/master" && ./install </dev/null
}

# shellcheck disable=SC2329
function install_dotfiles() {
  cd "${HOME}/nickolashkraus/dotfiles/master" && ./install </dev/null
}

# Refresh the short worktree symlinks under $HOME/w. Invoked by path rather
# than off PATH, since the install step above is what puts it on PATH.
# shellcheck disable=SC2329
function refresh_worktree_links() {
  "${HOME}/nickolashkraus/bash-scripts/master/worktree-links" --quiet
}

function main() {
  local force=false
  while [[ $# -gt 0 ]]; do
    case $1 in
      --force)
        force=true
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      -*)
        echo "system-update: unknown option '$1'" >&2
        usage >&2
        exit 1
        ;;
      *)
        echo "system-update: unknown argument '$1'" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  echo "=============================================================="
  echo "system-update: $(date '+%Y-%m-%d %H:%M:%S %Z')"
  echo "=============================================================="

  if [ "${force}" = false ] && lid_closed_on_battery; then
    skip_network=true
    echo "system-update: the lid is closed on battery; skipping every step but worktree-links (--force runs them)"
  fi

  # fh-sync requires FH_GITHUB_TOKEN. In an unattended job it cannot come from
  # an interactive shell export, so read it from the Login Keychain.
  if [ "${skip_network}" = false ] && [ -z "${FH_GITHUB_TOKEN:-}" ]; then
    FH_GITHUB_TOKEN="$(security find-generic-password -s fh-github-token -a function-health -w 2>/dev/null)"
    export FH_GITHUB_TOKEN
  fi

  network_step "vim plugins" update_vim
  network_step "Homebrew" update_brew
  network_step "Python tools (pipx, uv)" update_python_tools

  if [ "${skip_network}" = true ] || [ -n "${FH_GITHUB_TOKEN:-}" ]; then
    network_step "fh-sync Function-Health" sync_org "Function-Health"
    network_step "fh-sync Function-Health-Terraform-Modules" sync_org "Function-Health-Terraform-Modules"
  else
    echo ""
    echo -e "${red}==> fh-sync: SKIPPED (FH_GITHUB_TOKEN not found in Keychain)${reset}"
    ((failures++))
  fi

  # With no pull, the installs have no new revision to act on.
  network_step "git-pull ~/nickolashkraus" pull_personal
  network_step "bash-scripts install" install_bash_scripts
  network_step "dotfiles install" install_dotfiles
  run_step "worktree-links" refresh_worktree_links

  local summary="complete, ${failures} failure(s)"
  [ "${failures}" -eq 0 ] && summary="complete, 0 failures"
  [ "${skipped}" -gt 0 ] && summary+=", ${skipped} skipped (lid closed on battery)"
  echo ""
  echo "=============================================================="
  if [ "${failures}" -eq 0 ]; then
    echo -e "${green}system-update: ${summary}${reset}"
  else
    echo -e "${red}system-update: ${summary}${reset}"
  fi
  echo "=============================================================="

  exit "${failures}"
}

# Run only when executed, so a test can source the functions and stub them.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
